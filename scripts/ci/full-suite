#!/usr/bin/env bash
# Suite completa (ejecutar desde la raíz del repo): dependencias fijadas, tests
# unitarios, build (con presupuesto de peso) y end-to-end.
set -euo pipefail
npm ci --no-audit --no-fund
node --test "tests/*.test.mjs"
node --test "reel/tests/*.test.mjs"
node scripts/build.mjs
exec scripts/ci/e2e
